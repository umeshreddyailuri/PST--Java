import java.io.*;
import java.util.*;

class Result {

    public static List<Integer> maxSubarray(List<Integer> arr) {
        int current = arr.get(0);
        int maxSubarray = arr.get(0);

        int positiveSum = 0;
        int maxElement = arr.get(0);

        for (int i = 0; i < arr.size(); i++) {
            int x = arr.get(i);

            // Maximum subarray (contiguous)
            if (i > 0) {
                current = Math.max(x, current + x);
                maxSubarray = Math.max(maxSubarray, current);
            }

            // Maximum subsequence (non-contiguous)
            if (x > 0) {
                positiveSum += x;
            }

            maxElement = Math.max(maxElement, x);
        }

        int maxSubsequence;

        if (positiveSum > 0) {
            maxSubsequence = positiveSum;
        } else {
            maxSubsequence = maxElement;
        }

        return Arrays.asList(maxSubarray, maxSubsequence);
    }
}

public class Solution {

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(
            new InputStreamReader(System.in)
        );

        BufferedWriter bw = new BufferedWriter(
            new FileWriter(System.getenv("OUTPUT_PATH"))
        );

        int t = Integer.parseInt(br.readLine().trim());

        for (int test = 0; test < t; test++) {
            int n = Integer.parseInt(br.readLine().trim());

            String[] values = br.readLine().trim().split(" ");

            List<Integer> arr = new ArrayList<>();

            for (String value : values) {
                arr.add(Integer.parseInt(value));
            }

            List<Integer> result = Result.maxSubarray(arr);

            bw.write(result.get(0) + " " + result.get(1));
            bw.newLine();
        }

        br.close();
        bw.close();
    }
}
