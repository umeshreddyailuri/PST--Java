import java.util.*;
import java.util.stream.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        int[] salaries = new int[N];

        for (int i = 0; i < N; i++) {
            salaries[i] = sc.nextInt();
        }

        int[] updatedSalaries = Arrays.stream(salaries)
                .map(salary -> salary + (salary * 10 / 100))
                .toArray();

        for (int i = 0; i < updatedSalaries.length; i++) {

            System.out.print(updatedSalaries[i]);

            if (i < updatedSalaries.length - 1) {
                System.out.print(" ");
            }
        }

        sc.close();
    }
}
